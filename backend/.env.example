# Environment overrides for application.properties (used by Docker/Render).
# Locally you can instead use the git-ignored config/application.properties (see config.example.properties).
PORT=8114
HOST=127.0.0.1
DB_URL=jdbc:mysql://127.0.0.1:3306/railway?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=rail_app
DB_PASSWORD=
RAIL_ZONE=Asia/Kolkata
RAIL_ADMIN_EMAIL=
RAIL_ADMIN_PASSWORD=
RAIL_SEED=true
CORS_ORIGINS=http://localhost:5114,http://127.0.0.1:5114
